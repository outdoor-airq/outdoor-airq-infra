# monitoring/ altindaki HER IKI yigin icin (docker-compose.metrics.yml ve
# docker-compose.monitoring.yml) — ikisi de bu dizinden calistirildigi icin ayni .env'i okur.
# Gercek .env git'e GIRMEZ, izni 600 olur.
# Kurulum:  cp .env.example .env && chmod 600 .env  && doldur

# --- Uygulama agi ---
# Iki compose dosyasi da uygulamanin agina DISARIDAN baglaniyor ve ag adi ortama gore
# degisiyor. Tanimsiz birakilirsa varsayilan dev degeri kullanilir ve prod'da
# "network ... declared as external, but could not be found" hatasi alinir.
#   dev  (core/docker-compose.yml)       -> outdoor-airq-network
#   prod (infra/docker-compose.prod.yml) -> outdoor-airq_aqi-network
MONITORING_NETWORK=outdoor-airq-network

# --- Grafana -> TimescaleDB baglantisi ---
# SALT OKUNUR rol; core/.env'deki DB_USER (veritabani sahibi) DEGIL. Grafana'da
# Editor/Admin olan herkes Explore'dan serbest SQL calistirabiliyor, sahip
# kullaniciyla baglanmak bir Grafana parolasini DROP TABLE yetkisine cevirirdi.
# Rol timescaledb/init/03_grafana_ro.sh ile olusuyor (bkz. core deposu).
GRAFANA_DB_USER=grafana_ro
GRAFANA_DB_PASSWORD=

# --- Grafana arayuz girisi ---
# NOT: GF_SECURITY_ADMIN_PASSWORD yalnizca ILK acilista uygulanir. Sonradan degistirmek icin:
#   docker compose -f docker-compose.metrics.yml exec grafana \
#     grafana cli admin reset-admin-password <yeni>
GRAFANA_USER=admin
GRAFANA_PASSWORD=

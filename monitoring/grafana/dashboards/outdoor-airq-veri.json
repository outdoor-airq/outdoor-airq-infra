{
  "uid": "outdoor-airq-veri",
  "title": "outdoor-airq — Veri",
  "description": "Uygulamanin kendi verisi, dogrudan TimescaleDB'den. Arada exporter yok; Grafana canli tabloya SQL soruyor.",
  "tags": ["outdoor-airq", "aqi"],
  "timezone": "Europe/Istanbul",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Son verinin yasi",
      "description": "max(measured_at) ile simdi arasindaki fark. Esikler backend /health ile ayni mantikta: 3 saati asarsa akis durmus sayilir.",
      "datasource": { "type": "postgres", "uid": "timescaledb" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT round(EXTRACT(EPOCH FROM (now() - max(measured_at)))/60) AS \"dakika\" FROM raw_readings"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 120 },
              { "color": "red", "value": 180 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Istasyon",
      "datasource": { "type": "postgres", "uid": "timescaledb" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS \"istasyon\" FROM stations"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Toplam olcum",
      "datasource": { "type": "postgres", "uid": "timescaledb" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS \"olcum\" FROM raw_readings"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Anomali",
      "description": "Canli EMA tespitleri (aqi_anomalies). Backfill kaynakli olanlar filtered_readings'te, burada degil.",
      "datasource": { "type": "postgres", "uid": "timescaledb" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS \"anomali\" FROM aqi_anomalies"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Istasyon bazinda AQI",
      "description": "WAQI saatlik yayin yaptigi icin cizgiler saat basi kirilir; ara noktalarin olmamasi veri kaybi degil.",
      "datasource": { "type": "postgres", "uid": "timescaledb" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 5 },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT measured_at AS \"time\", station_name AS metric, aqi::float FROM raw_readings WHERE $__timeFilter(measured_at) AND aqi IS NOT NULL ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 5,
            "showPoints": "auto",
            "spanNulls": true
          },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Her istasyonun son olcumu",
      "datasource": { "type": "postgres", "uid": "timescaledb" },
      "gridPos": { "h": 11, "w": 24, "x": 0, "y": 15 },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT DISTINCT ON (station_id) station_name AS \"Istasyon\", aqi AS \"AQI\", dominant AS \"Baskin kirletici\", pm25 AS \"PM2.5\", pm10 AS \"PM10\", temperature AS \"Sicaklik\", measured_at AS \"Olcum\" FROM raw_readings ORDER BY station_id, measured_at DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "filterable": true },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "AQI" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 51 },
                    { "color": "orange", "value": 101 },
                    { "color": "red", "value": 151 },
                    { "color": "purple", "value": 201 }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "sortBy": [{ "displayName": "AQI", "desc": true }],
        "showHeader": true
      }
    }
  ]
}

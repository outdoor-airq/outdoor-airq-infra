        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH saatler AS (SELECT DISTINCT time_bucket('1 hour', measured_at) AS saat FROM raw_readings WHERE $__timeFilter(measured_at) AND measured_at <= now()), sinirli AS (SELECT saat FROM saatler UNION ALL SELECT time_bucket('1 hour', now() - interval '3 hours')), farklar AS (SELECT saat, lag(saat) OVER (ORDER BY saat) AS onceki FROM sinirli) SELECT COALESCE(max(EXTRACT(EPOCH FROM (saat - onceki))/3600), 0) AS \"saat\" FROM farklar WHERE onceki IS NOT NULL AND saat - onceki > interval '1 hour'"
        }
      ]
    },

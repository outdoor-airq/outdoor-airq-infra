    {
      "id": 13,
      "type": "stat",
      "title": "En uzun veri boslugu (30 gun)",
      "description": "Son 30 günde yaşanan **en uzun** veri kesintisi. 0 görüyorsan hiç kesinti olmamış demektir. 3 saati geçerse sarı, 12 saati geçerse kırmızı olur. Kesinti genelde internet ya da kaynak servis kaynaklıdır; o dönemin verisi geri getirilemez.",
      "datasource": {
        "type": "postgres",
        "uid": "timescaledb"
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 0,
        "y": 38
      },
      "timeFrom": "30d",
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null

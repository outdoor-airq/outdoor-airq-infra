# Sunucudaki gerçek .env git'e GİRMEZ (.gitignore'da) ve izni 600 olmalı.
# Kurulum:  cp .env.example .env  && chmod 600 .env  && doldur

# --- Kimlik / sırlar ---
DB_USER=outdoorairq
DB_PASSWORD=            # güçlü, rastgele
WAQI_TOKEN=             # aqicn.org/data-platform/token
CLOUDFLARED_TOKEN=      # Cloudflare Zero Trust -> Networks -> Tunnels
# Hostname'ler bu alan adının ALTINDA, tek seviye olarak tanımlanır:
#   outdoor-airq.${DOMAIN}       -> frontend
#   outdoor-airq-api.${DOMAIN}   -> backend
# İki seviyeli ad (app.outdoor-airq.${DOMAIN}) kullanılmıyor çünkü Cloudflare Universal
# SSL yalnız tek seviye joker (*.${DOMAIN}) kapsıyor, iki seviyeli ad ücretsiz sertifika
# almıyor. Mevcut kurulumda DOMAIN=arteq.com.tr (bkz. dokuman/CLOUDFLARE-KURULUM.md).
DOMAIN=arteq.com.tr
GH_ORG=outdoor-airq

# --- Image SHA pinleri ---
# deploy.yml her repository_dispatch'te ilgili satırı günceller. "latest" ASLA kullanılmaz:
# prod'da hangi kodun çalıştığı belirsizleşir ve rollback imkânsızlaşır.
# Değişken adı = <servis-adı büyük harf, tire → alt çizgi>_SHA (deploy.yml mekanik türetir)
BACKEND_SHA=
MQTT_SHA=
AQI_FLINK_JOB_SHA=
# FLINK_TASKMANAGER_SHA yok: taskmanager upstream flink image'ini doğrudan kullanıyor
# (docker-compose.prod.yml'deki açıklamaya bak). Geri eklenirse buraya da satır gerekir.
FLINK_JOB_SHA=
ENERGY_PUBLISHER_SHA=
SYNTHETIC_DATA_SHA=
